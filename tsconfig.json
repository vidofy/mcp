{
  "compilerOptions": {
    /* Node 18+ is the floor (the SDK's own engines field), and the package is
       ESM — the SDK is ESM-first and a CJS build would fight it. */
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],

    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    // ON for local development, and excluded from the tarball by the
    // negated dist map pattern in package.json "files".
    //
    // The maps carry no sourcesContent, so publishing them without the sources
    // is a set of pointers to files that are not there. The obvious fix — ship
    // src/ as well — was made on 2026-09-07 and reverted the same day: source
    // comments in this package document Vidofy's own economics (one spelled
    // out a real generation's coins beside its provider cost, which together
    // ARE the markup), and a published tarball is the wrong place for that.
    // Neither, then. The repository is where the sources belong.
    "sourceMap": true,

    /* Strict throughout. This package's whole job is translating one API's
       shapes into another's, and that is exactly the work where an implicit
       any turns a wrong field name into a silent undefined at runtime. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
